{
    "chapterEn": "Chapter 32",
    "chapterAs": "ܩܦܠܐܘܢ: ܠܒ.",
    "verses": [
        {
            "verseNumberEn": "1",
            "verseNumberAs": "ܐ",
            "verseText": "ܘܚܙܹܠܹܐ ܛܵܝܸܦܵܐ ܕܥܘܼܪܩܸܠܹܐ ܡܘܼܫܹܐ ܠܸܨܠܵܝܵܐ ܡ̣ܢ ܛܘܼܪܵܐ: ܘܓ̰ܡܸܥܠܹܐ ܛܵܝܸܦܵܐ ܥܲܠ ܐܲܗܪܘܿܢ: ܘܐ݇ܡܸܪܘܿܢ ܐܸܠܹܗ: ܩܘܼܡ݇ ܥܒ̣ܘܿܕ ܠܲܢ ܐܲܠܵܗܹ̈ܐ ܕܐܵܙܠ݇ܝܼ ܩܵܡܲܢ: ܣܵܒܵܒ̇ ܕܐܵܗܵܐ ܡܘܼܫܹܐ: ܐ݇ܢܵܫܵܐ ܕܡܘܼܐܣܸܩܠܹܐ ܐܸܠܲܢ ܡ̣ܢ ܐܲܪܥܵܐ ܕܡܸܨܪܹܝܢ: ܠܹܐ ܝ݇ܘܵܟ ܒܝܼܕܲܥܝܵܐ ܡܘܼܕܝܼ ܗ݇ܘܹܠܵܐ ܠܹܗ."
        },
        {
            "verseNumberEn": "2",
            "verseNumberAs": "ܒ",
            "verseText": "ܘܐ݇ܡܸܪܹܐ ܐܸܠܵܝ ܐܲܗܪܘܿܢ: ܦܵܠܛܘܿܢ ܩܢܲܫܝܵܬܹ̈ܐ ܕܕܲܗܒ̣ܵܐ ܕܝܼܢܵܐ ܒܢܵܬ̈ܝܵܬܹܐ ܕܒܲܟ̣ܬܵܬܵܘ̈ܟ̣ܘܿܢ: ܕܒܢܘܼܢܵܘ̈ܟ̣ܘܿܢ: ܘܕܒܢܵܬܵܘ̈ܟ̣ܘܿܢ: ܘܡܵܐܝܡܘܿܢ ܠܟܸܣܠܝܼ."
        },
        {
            "verseNumberEn": "3",
            "verseNumberAs": "ܓ",
            "verseText": "ܘܦܘܼܠܸܛܠܘܿܢ ܟܠܹܗ ܛܵܝܸܦܵܐ ܠܩܢܲܫܝܵܬܹ̈ܐ ܕܕܲܗܒ̣ܵܐ ܕܝܼܗ݇ܘܵܘ ܒܢܵܬ̈ܝܵܬܵܝ: ܘܡܘܼܐܝܹܠܘܿܢ ܠܟܸܣ ܐܲܗܪܘܿܢ."
        },
        {
            "verseNumberEn": "4",
            "verseNumberAs": "ܕ",
            "verseText": "ܘܫܩܸܠܹܐ ܡ̣ܢ ܐܝܼܕܵܝ: ܘܥܒܸܕܠܹܗ ܨܘܼܪܬܵܐ ܒܡܲܩܵܪ: ܘܩܲܡ ܬܵܪܸܨ ܠܹܗ ܡܘܼܓ̰ܵܐ ܪܸܡܝܵܐ: ܘܐ݇ܡܸܪܘܿܢ: ܐܲܢܹܐ ܝ݇ܢܵܐ ܐܲܠܵܗ̈ܘܼܟ: ܝܼܣܪܵܝܹܠ: ܕܡܘܼܐܣܸܩܠܘܿܢ ܐܸܠܘܼܟ ܡ̣ܢ ܐܲܪܥܵܐ ܕܡܸܨܪܹܝܢ."
        },
        {
            "verseNumberEn": "5",
            "verseNumberAs": "ܗ",
            "verseText": "ܘܚܙܹܠܹܐ ܐܲܗܪܘܿܢ ܘܒܢܹܠܹܐ ܡܲܕܒ̇ܚܵܐ ܩܵܡܘܼܗܝ: ܘܩܪܹܠܹܐ ܐܲܗܪܘܿܢ ܘܐ݇ܡܸܪܹܐ: ܥܹܐܕܵܐ ܝ݇ܠܹܐ ܠܡܵܪܝܵܐ ܩܵܝܕܲܡܬܵܐ."
        },
        {
            "verseNumberEn": "6",
            "verseNumberAs": "ܘ",
            "verseText": "ܘܩܸܡܠܘܿܢ ܓ̰ܼܿܠܕܹܐ ܒܩܵܝܕܲܡܬܵܐ: ܘܡܘܼܐܣܸܩܠܘܿܢ ܕܸܒ̣ܚܹ̈ܐ ܡܘܼܩ̈ܕܹܐ: ܘܡܘܼܩܪܸܒ̣ܠܘܿܢ ܩܘܼܪ̈ܒܵܢܹܐ ܕܫܠܵܡܵܐ. ܘܝ݇ܬܸܒ̣ܠܹܐ ܛܵܝܸܦܵܐ ܠܹܐܟ̣ܵܠܵܐ ܘܠܸܫܬܵܝܵܐ: ܘܩܸܡܠܘܿܢ ܠܛܵܒ̣ܘܿܠܹܐ."
        },
        {
            "verseNumberEn": "7",
            "verseNumberAs": "ܙ",
            "verseText": "ܘܗܘܼܡܙܸܡܠܹܐ ܡܵܪܝܵܐ ܥܲܡ ܡܘܼܫܹܐ: ܙܹܐ: ܨܠܝܼ: ܣܵܒܵܒ̇ ܕܡܘܼܚܪܸܒ̣ܠܹܐ ܓܵܢܘܼܗܝ ܛܵܝܸܦܘܼܟ ܕܡܘܼܣܸܩܠܘܼܟ ܡ̣ܢ ܐܲܪܥܵܐ ܕܡܸܨܪܹܝܢ."
        },
        {
            "verseNumberEn": "8",
            "verseNumberAs": "ܚ",
            "verseText": "ܩܠܸܒ̇ܠܘܿܢ ܓ̰ܼܿܠܕܹܐ ܡ̣ܢ ܐܘܼܪܚܵܐ ܕܦܩܝܼܕܵܝܠܝܼ: ܬܘܼܪܸܨܠܘܿܢ ܩܵܬܵܝ ܡܘܼܓ̰ܵܐ ܪܸܡܝܵܐ: ܘܣܓܸܕܠܘܿܢ ܐܸܠܹܗ: ܘܥܒܸܕܠܘܿܢ ܕܸܒ̣ܚܵܐ ܐܸܠܹܗ: ܘܐ݇ܡܸܪܘܿܢ: ܐܲܢܹܐ ܝ݇ܢܵܐ ܐܲܠܵܗ̈ܘܼܟ: ܝܼܣܪܵܝܹܠ: ܕܡܘܼܐܣܸܩܠܘܿܢ ܐܸܠܘܼܟ ܡ̣ܢ ܐܲܪܥܵܐ ܕܡܸܨܪܹܝܢ."
        },
        {
            "verseNumberEn": "9",
            "verseNumberAs": "ܛ",
            "verseText": "ܘܐ݇ܡܸܪܹܐ ܡܵܪܝܵܐ ܠܡܘܼܫܹܐ: ܚܙܹܠܝܼ ܠܐܵܗܵܐ ܛܵܝܸܦܵܐ: ܘܗܵܐ: ܛܵܝܸܦܵܐ ܩܫܹܐ-ܩܕܵܠܵܐ ܝ݇ܠܹܐ."
        },
        {
            "verseNumberEn": "10",
            "verseNumberAs": "ܝ",
            "verseText": "ܘܐܵܕܝܼܵܐ ܫܒ̣ܘܿܩ ܠܝܼ: ܘܚܵܝܡܵܐ ܟܲܪܒܝܼ ܒܝܼܵܝ: ܘܬܵܝܡܸܢܘܿܢ: ܘܒܸܬ ܥܵܒ̣ܕܸ‍ܢ ܐܸܠܘܼܟ ܠܛܵܝܸܦܵܐ ܓܘܼܪܵܐ."
        },
