{
    "chapterEn": "Chapter 30",
    "chapterAs": "ܩܦܠܐܘܢ: ܠ.",
    "verses": [
        {
            "verseNumberEn": "1",
            "verseNumberAs": "ܐ",
            "verseText": "ܘܬܵܪܨܸܬ ܡܲܕܒ̇ܚܵܐ ܠܡܵܩܘܿܕܹܐ ܒܸܣܡܵܐ: ܕܩܲܝܣܹ̈ܐ ܕܫܸܛܝܼܡ ܬܵܪܨܸܬ ܠܹܗ."
        },
        {
            "verseNumberEn": "2",
            "verseNumberAs": "ܒ",
            "verseText": "ܝܲܡܝܼܢܵܐ ܝܘܼܪܟ̣ܘܼܬܘܼܗܝ: ܘܝܲܡܝܼܢܵܐ ܦܸܬܝܘܼܬܘܼܗܝ: ܟ̰ܗܵܪܓܘܼܫܵܐ ܗܵܘܹܐ: ܘܬܪܵܝ ܝܲܡܝܼܢܹ̈ܐ ܪܵܡܘܼܬܘܼܗܝ: ܡܸܢܹܗ ܩܵܪ̈݇ܢܵܢܘܼܗܝ."
        },
        {
            "verseNumberEn": "3",
            "verseNumberAs": "ܓ",
            "verseText": "ܘܩܵܪܡܸܬ ܠܹܗ ܕܲܗܒ̣ܵܐ ܨܸܦܝܵܐ: ܠܐ݇ܓܵܪܘܼܗܝ ܘܠܓܘܼܕܵܢܘܼ̈ܗܝ ܚܵܕܸܪ̈ܘܵܢܹܐ: ܘܠܩܵܪ̈݇ܢܵܢܘܼܗܝ: ܘܬܵܪܨܸܬ ܩܵܬܹܗ ܟܠܝܼܠܵܐ ܕܕܲܗܒ̣ܵܐ ܚܵܕܸܪ̈ܘܵܢܹܐ."
        },
        {
            "verseNumberEn": "4",
            "verseNumberAs": "ܕ",
            "verseText": "ܘܬܪܵܝ ܗܵܠܲܩܝܵܬܹ̈ܐ ܕܕܲܗܒ̣ܵܐ ܬܵܪܨܸܬ ܐܸܠܹܗ ܠܸܐܠܬܸܚ ܡ̣ܢ ܟܠܝܼܠܘܼܗܝ: ܥܲܠ ܬܸܪܘܵܝ ܓܹܒܵܢܘܼܗ̈ܝ: ܬܵܪܨܸܬ ܥܲܠ ܬܸܪܘܵܝ ܕܸܦܢܵܬ̈ܘܼܗܝ: ܘܗܵܘܝܼ ܕܘܼܟܵܢܹ̈ܐ ܩܵܐ ܕܝܼܘܲܢܝܵܬܹ̈ܐ ܠܸܛܥܵܢܘܼܗܝ ܒܝܼܵܝ."
        },
        {
            "verseNumberEn": "5",
            "verseNumberAs": "ܗ",
            "verseText": "ܘܬܵܪܨܸܬ ܕܝܼܘܲܢܝܵܬܹ̈ܐ ܕܩܲܝܣܹ̈ܐ ܕܫܸܛܝܼܡ: ܘܩܵܪܡܸܬ ܠܗ݇ܘܿܢ ܕܲܗܒ̣ܵܐ."
        },
        {
            "verseNumberEn": "6",
            "verseNumberAs": "ܘ",
            "verseText": "ܘܡܲܬܒܸܬ ܠܹܗ ܩܵܡ ܣܸܬܪܵܐ ܕܥܲܠ ܩܹܒ̣ܘܼܬܵܐ ܕܣܵܗܕܘܼܬܵܐ: ܩܵܡ ܚܘܼܣܵܝܵܐ ܕܝܼܠܹܐ ܥܲܠ ܣܵܗܕܘܼܬܵܐ: ܕܒܸܬ ܬܵܦܩܸܢ ܒܘܲܥܕܵܐ ܒܝܼܘܼܟ ܬܵܡܵܐ."
        },
        {
            "verseNumberEn": "7",
            "verseNumberAs": "ܙ",
            "verseText": "ܘܡܵܩܸܕ ܥܲܠܘܼܗܝ ܐܲܗܪܘܿܢ ܒܸܣܡܵܐ ܕܐܲܕ̈ܘܹܐ: ܨܲܦܪܵܐ ܒܨܲܦܪܵܐ: ܒܥܕܵܢܵܐ ܕܗܵܕܸܪ ܠܫܪ̈ܵܝܵܬܹܐ: ܡܵܩܸܕ ܠܹܗ."
        },
        {
            "verseNumberEn": "8",
            "verseNumberAs": "ܚ",
            "verseText": "ܘܒܥܕܵܢܵܐ ܕܡܵܐܣܸܩ ܐܲܗܪܘܿܢ ܠܫܪ̈ܵܝܵܬܹܐ ܒܒܹܝܬ݇ ܪܲ̈ܡܫܹܐ: ܡܵܩܸܕ ܠܹܗ: ܒܸܣܡܵܐ ܕܕܵܝܸܡܘܼܬܵܐ ܩܵܡ ܡܵܪܝܵܐ ܠܕܵܘܪ̈ܵܘܟ̣ܘܿܢ."
        },
        {
            "verseNumberEn": "9",
            "verseNumberAs": "ܛ",
            "verseText": "ܠܐܵ ܡܵܐܣܩܝܼܬܘܿܢ ܥܲܠܘܼܗܝ ܒܸܣܡܵܐ ܢܘܼܟ̣ܪܵܝܵܐ: ܘܕܸܒ̣ܚܵܐ ܡܘܼܩܕܵܐ: ܘܩܘܼܪܒܵܢܵܐ ܕܕܲܚܠܵܐ: ܘܢܘܼܩܵܝܵܐ ܠܵܐ ܨܲܢܨܸܠܝܼܬܘܿܢ ܥܲܠܘܼܗܝ."
        },
        {
